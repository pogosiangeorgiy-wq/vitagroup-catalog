# VITA GROUP — статичный сайт на Apache (Бегет)

DirectoryIndex index.html index.htm
AddDefaultCharset UTF-8

# Принудительный HTTPS — включить ПОСЛЕ выпуска сертификата Let's Encrypt
# в панели Бегета (Домены и поддомены → SSL). Пока сертификата нет,
# редирект оставит сайт недоступным, поэтому блок закомментирован.
#<IfModule mod_rewrite.c>
#  RewriteEngine On
#  RewriteCond %{HTTPS} !=on
#  RewriteCond %{HTTP:X-Forwarded-Proto} !https
#  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
#</IfModule>

# Сжатие текстовых ресурсов
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Кэш статики: шрифты и картинки надолго, HTML — без кэша
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|jpg|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
</IfModule>

# Правильный MIME для шрифтов
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
</IfModule>

ErrorDocument 404 /index.html
